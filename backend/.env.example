# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="AI Chatbot Backend"
API_V1_PREFIX="/api/v1"

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Security & JWT
SECRET_KEY=generate_a_super_secret_key_at_least_32_characters_long_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL Database Configuration (Async Driver asyncmy or aiomysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=chatbot_user
MYSQL_PASSWORD=chatbot_password
MYSQL_DB=chatbot_db
DATABASE_URL=mysql+asyncmy://chatbot_user:chatbot_password@localhost:3306/chatbot_db

# Redis Configuration (For Rate Limiting & Session Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_DEFAULT="60/minute"
RATE_LIMIT_CHAT="20/minute"
RATE_LIMIT_AUTH="10/minute"

# LLM Providers Configuration
# Supported providers: 'openai' or 'anthropic'
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MAX_CONTEXT_MESSAGES=10
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1024
